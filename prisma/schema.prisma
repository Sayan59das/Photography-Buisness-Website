generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(EDITOR)
  createdAt    DateTime @default(now())
}

enum Role {
  ADMIN
  EDITOR
}

model Category {
  id     String  @id @default(cuid())
  name   String
  slug   String  @unique
  shoots Shoot[]
}

model Shoot {
  id             String       @id @default(cuid())
  title          String
  slug           String       @unique
  categoryId     String
  category       Category     @relation(fields: [categoryId], references: [id])
  coverImageUrl  String
  story          String?      @db.Text
  location       String?
  shootDate      DateTime?
  isFeatured     Boolean      @default(false)
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?      @db.Text
  images         ShootImage[]
}

model ShootImage {
  id         String @id @default(cuid())
  shootId    String
  shoot      Shoot  @relation(fields: [shootId], references: [id], onDelete: Cascade)
  imageUrl   String
  publicId   String
  altText    String?
  sortOrder  Int    @default(0)
}

model Testimonial {
  id          String   @id @default(cuid())
  clientName  String
  eventType   String?
  quote       String   @db.Text
  rating      Int      @default(5)
  imageUrl    String?
  isApproved  Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Booking {
  id           String        @id @default(cuid())
  name         String
  email        String
  phone        String?
  eventType    String?
  eventDate    DateTime?
  location     String?
  budgetRange  String?
  message      String?       @db.Text
  status       BookingStatus @default(NEW)
  createdAt    DateTime      @default(now())
}

enum BookingStatus {
  NEW
  CONTACTED
  CONFIRMED
  CLOSED
}

model Service {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  priceLabel  String?
  features    String[]
  sortOrder   Int      @default(0)
}

model BlogPost {
  id             String    @id @default(cuid())
  title          String
  slug           String    @unique
  excerpt        String?   @db.Text
  content        String    @db.Text
  coverImageUrl  String?
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?   @db.Text
}
